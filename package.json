{
  "name": "cutroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run build && playwright test",
    "schemas": "node scripts/schemas.mjs",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@napi-rs/keyring": "2.1.2",
    "@remotion/bundler": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/zod-types": "4.0.540",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "hyperframes": "0.9.2",
    "jsdom": "16.7.0",
    "lucide-react": "1.27.0",
    "nanoid": "5.1.16",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.540",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "16.2.15",
    "@types/node": "22.18.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "4.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.3.0",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zod-to-json-schema": "3.25.2"
  }
}
